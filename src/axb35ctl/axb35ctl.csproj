<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10/11, so axb35ctl.exe runs with nothing else installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>axb35ctl</AssemblyName>
    <RootNamespace>Axb35Ctl</RootNamespace>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Axb35.Ec\*.cs" Link="Ec\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\resources\LpcACPIEC.bin" LogicalName="Axb35.Ec.LpcACPIEC.bin" />
  </ItemGroup>

</Project>
